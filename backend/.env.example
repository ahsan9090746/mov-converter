NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:4000,http://127.0.0.1:4000
MAX_FILE_SIZE_MB=500
# Soft UX batch size — set high for "unlimited" bulk in one go.
# The FIFO queue still converts sequentially to protect CPU/RAM.
MAX_FILES_PER_BATCH=500
CLEANUP_AFTER_MINUTES=30
# Optional: override ffmpeg binary path. Defaults to ffmpeg-static binary, falls back to system ffmpeg.
# FFMPEG_PATH=ffmpeg
# Optional: override ffprobe binary path (used to detect the fast remux path).
# Defaults to ffprobe-static binary, falls back to system ffprobe.
# FFPROBE_PATH=ffprobe
# Optional: cap concurrent conversions to protect CPU (Render starter has limited CPU)
MAX_CONCURRENT_CONVERSIONS=2
# Optional: rate limiting (big bulk batches upload + poll; keep headroom)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
# Optional: quality tuning (defaults = visually lossless + fast).
# CRF 18 ≈ no visible loss (23 = default, 26+ = visible loss). Lower = better + bigger file.
# Preset: ultrafast < superfast < veryfast < faster < fast < medium (slower = slightly better compression).
# VIDEO_PRESET=veryfast
# VIDEO_CRF=18
# AUDIO_BITRATE=192k
