NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:4000,http://127.0.0.1:4000
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_BATCH=10
CLEANUP_AFTER_MINUTES=30
# Optional: override ffmpeg binary path. Defaults to ffmpeg-static binary, falls back to system ffmpeg.
# FFMPEG_PATH=ffmpeg
# Optional: override ffprobe binary path (used to detect the fast remux path).
# Defaults to ffprobe-static binary, falls back to system ffprobe.
# FFPROBE_PATH=ffprobe
# Optional: cap concurrent conversions to protect CPU (Render starter has limited CPU)
MAX_CONCURRENT_CONVERSIONS=2
# Optional: rate limiting (a 10-file batch uploads + polls; keep headroom)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
